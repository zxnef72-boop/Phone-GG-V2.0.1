API_KEY=ganti_dengan_api_key_rahasia

# Login web PhoneGG
# Username default: admin -- password diambil dari sini
AUTH_DEFAULT_PASSWORD=ganti_password_ini
# Kalau mau lebih dari satu akun, isi AUTH_USERS (format: user1:hash1,user2:hash2)
# generate hash lewat python: generate_password_hash("password_kamu")
# AUTH_USERS=

GOOGLE_API_KEY=
GOOGLE_CX=
HIBP_API_KEY=

# Opsional -- isi SATU ATAU LEBIH ini kalau mau chatbot AIZX bisa ngobrol
# natural (gak kaku) buat diskusi bebas & pembelajaran.
# Kalau semua kosong, AIZX tetap jalan 100% offline (rule-based).
# Kalau lebih dari satu diisi, AIZX otomatis coba urut dari atas -- kalau
# satu provider kena limit/gagal, otomatis lanjut ke provider berikutnya.

# PALING DIREKOMENDASIKAN kalau mau BENAR-BENAR offline & gratis selamanya:
# install Ollama (https://ollama.com) di komputer/VPS sendiri, jalankan
# `ollama pull llama3.2` (atau model lain sesuai RAM: qwen2.5:3b lebih ringan),
# lalu isi OLLAMA_URL di bawah. Tidak butuh API key, tidak ada limit request,
# jalan sepenuhnya di mesin kamu -- ini yang dicoba PALING DULU kalau diisi.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# REKOMENDASI KEDUA (kalau device gak kuat jalanin model lokal): GRATIS, limit paling longgar.
# Ambil key di https://console.groq.com/keys (login -> Create API Key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternatif gratis: GitHub Models (Azure AI Inference), akses model Claude
# 3.5 Sonnet dkk pakai token GitHub biasa. Bikin token (classic atau fine-
# grained, tidak perlu scope khusus) di https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=claude-3-5-sonnet
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# Alternatif gratis (limit lebih ketat & sering kena 429/quota habis).
# Ambil key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Alternatif gratis (banyak pilihan model dengan akhiran :free).
# Ambil key di https://openrouter.ai/keys
# CATATAN: daftar model gratis OpenRouter suka berubah tiap minggu (model
# lama bisa didepak kapan saja -> muncul error 404 "unavailable for free").
# Kalau OPENROUTER_MODEL di bawah ini mulai error 404, cek daftar model
# gratis TERBARU di https://openrouter.ai/models?max_price=0 lalu ganti
# slug-nya di sini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Alternatif berbayar (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
